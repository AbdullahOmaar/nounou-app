# انسخ الملف ده إلى .env.local واملأ القيم من مشروع Supabase بتاع «نونو»
# (Project Settings → API في لوحة Supabase) — انظر docs/ACTIVATION.md

# رابط المشروع — مثال: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# مفتاح anon public — آمن للاستخدام في المتصفح لأن الحماية بـ RLS
VITE_SUPABASE_ANON_KEY=

# ملحوظة: من غير القيم دي التطبيق بيشتغل في وضع غير متصل (واجهة فقط).
